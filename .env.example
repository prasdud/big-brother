# Listen address
BB_ADDR=:8080

# SQLite database file
BB_DB_PATH=./data/big-brother.db

# Log level: debug | info | warn | error
BB_LOG_LEVEL=info

# Absolute base URL, used for links
BB_BASE_URL=http://localhost:8080

# Workspace name, used only when the database is first created
BB_WORKSPACE_NAME=Default

# Raw check retention in days
BB_RETENTION_DAYS=30

# Number of concurrent check workers
BB_CHECK_WORKERS=16

# Secret key for encrypting tokens at rest (required for Slack, M4)
# BB_SECRET_KEY=
